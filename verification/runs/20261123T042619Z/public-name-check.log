  (Q : Overfull.Multigraph V E) (a b : V) (hab : a ≠ b) (h : ℕ) {C : Finset (E ⊕ Fin h)}
  (hC : (Q.pairAugmentation a b hab h).IsCircuit C) (hvirtual : C.toRight = ∅) : Q.IsCircuit C.toLeft
Overfull.Multigraph.IsCircuit.one_pairVirtual_original.{u_1, u_2} {V : Type u_1} {E : Type u_2}
  (Q : Overfull.Multigraph V E) (a b : V) (hab : a ≠ b) (h : ℕ) [Fintype V] {C : Finset (E ⊕ Fin h)}
  (hC : (Q.pairAugmentation a b hab h).IsCircuit C) (hvirtual : C.toRight.card = 1) :
  C.toLeft.card + 1 ≤ Fintype.card V ∧
    (∀ (v : V), v = a ∨ v = b → Q.degreeOn C.toLeft v = 1) ∧ ∀ (v : V), Odd (Q.degreeOn C.toLeft v) ↔ v = a ∨ v = b
