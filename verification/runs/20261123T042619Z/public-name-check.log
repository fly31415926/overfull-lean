Overfull.Multigraph.pairAugmentation_secondEnd_inl.{u_1, u_2} {V : Type u_1} {E : Type u_2}
  (Q : Overfull.Multigraph V E) (a b : V) (hab : a ≠ b) (h : ℕ) (e : E) :
