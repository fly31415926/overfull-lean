Overfull.Multigraph.pairAugmentation_virtual_crosses.{u_1, u_2} {V : Type u_1} {E : Type u_2}
  (Q : Overfull.Multigraph V E) (a b : V) (hab : a ≠ b) (h : ℕ) (j : Fin h) (X : Finset V) :
  ((Q.pairAugmentation a b hab h).firstEnd (Sum.inr j) ∈ X) ≠
      ((Q.pairAugmentation a b hab h).secondEnd (Sum.inr j) ∈ X) ↔
    (a ∈ X) ≠ (b ∈ X)
