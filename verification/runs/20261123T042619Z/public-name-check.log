  (Q.pairAugmentation a b hab h).degreeOn C v = Q.degreeOn C.toLeft v + if v = a ∨ v = b then C.toRight.card else 0
Overfull.Multigraph.pairAugmentation_edgeSupport_of_no_virtual.{u_1, u_2} {V : Type u_1} {E : Type u_2}
  (Q : Overfull.Multigraph V E) (a b : V) (hab : a ≠ b) (h : ℕ) {C : Finset (E ⊕ Fin h)} (hvirtual : C.toRight = ∅) :
