      Finset.univ)
  {D D' : Finset (E ⊕ Fin h)} (hD : D ∈ P.parts) (hD' : D' ∈ P.parts) (hne : D ≠ D') : Disjoint D.toLeft D'.toLeft
Overfull.Multigraph.CompatibleCircuitPartition.pairOriginal_restriction_injective.{u_1, u_2, u_3} {V : Type u_1}
  {E : Type u_2} {K : Type u_3} {Q : Overfull.Multigraph V E} {a b : V} {hab : a ≠ b} {h : ℕ} [Fintype E]
