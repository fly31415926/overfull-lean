Overfull.Multigraph.IsMatching.internalOn.{u_1, u_2} {V : Type u_1} {E : Type u_2} (G : Overfull.Multigraph V E)
  {M : Finset E} (hM : G.IsMatching M) (Z : Finset V) : G.IsMatching (G.internalOn M Z)
Overfull.Multigraph.IsPerfectMatching.edgeSupport_eq_univ.{u_1, u_2} {V : Type u_1} {E : Type u_2}
  (G : Overfull.Multigraph V E) [Fintype V] {M : Finset E} (hM : G.IsPerfectMatching M) : G.edgeSupport M = Finset.univ
Overfull.Multigraph.IsPerfectMatching.even_card.{u_1, u_2} {V : Type u_1} {E : Type u_2} (G : Overfull.Multigraph V E)
  [Fintype V] {M : Finset E} (hM : G.IsPerfectMatching M) : Even (Fintype.card V)
Overfull.Multigraph.edgeSupport_internalOn_subset.{u_1, u_2} {V : Type u_1} {E : Type u_2} (G : Overfull.Multigraph V E)
  (M : Finset E) (Z : Finset V) : G.edgeSupport (G.internalOn M Z) ⊆ Z
Overfull.Multigraph.labelQuotient_classCutOn_endpointClass.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2} {I : Type u_3}
  (G : Overfull.Multigraph V E) (label : V → I) (hjoin : ∀ (e : E), label (G.firstEnd e) ≠ label (G.secondEnd e))
  (C : Finset E) (i : I) (v : V) (A : Finset I) :
  (G.labelQuotient label hjoin).classCutOn (G.endpointClass label) C i v A =
    if label v = i then {e ∈ (G.labelQuotient label hjoin).cutOn C A | v ∈ G.edge e} else ∅
Overfull.Multigraph.labelQuotient_endpointClass_incident_iff.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2}
  {I : Type u_3} (G : Overfull.Multigraph V E) (label : V → I)
  (hjoin : ∀ (e : E), label (G.firstEnd e) ≠ label (G.secondEnd e)) (e : E) (i : I) (v : V) :
  i ∈ (G.labelQuotient label hjoin).edge e ∧ G.endpointClass label i e = v ↔ label v = i ∧ v ∈ G.edge e
Overfull.Multigraph.label_endpointClass_of_incident.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2} {I : Type u_3}
  (G : Overfull.Multigraph V E) (label : V → I) (hjoin : ∀ (e : E), label (G.firstEnd e) ≠ label (G.secondEnd e))
  {e : E} {i : I} (hi : i ∈ (G.labelQuotient label hjoin).edge e) : label (G.endpointClass label i e) = i
Overfull.Multigraph.mem_internalOn_of_incident_otherEnd.{u_1, u_2} {V : Type u_1} {E : Type u_2}
  (G : Overfull.Multigraph V E) {M : Finset E} {Z : Finset V} {e : E} (he : e ∈ M) {v : V} (hv : v ∈ G.edge e)
  (hvZ : v ∈ Z) (hoZ : G.otherEnd v e ∈ Z) : e ∈ G.internalOn M Z
Overfull.Multigraph.otherEnd_mem_of_mem_internalOn.{u_1, u_2} {V : Type u_1} {E : Type u_2}
  (G : Overfull.Multigraph V E) {M : Finset E} {Z : Finset V} {e : E} (he : e ∈ G.internalOn M Z) (v : V) :
  G.otherEnd v e ∈ Z
Overfull.Multigraph.pairAugmentation_admissibleOn.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2} {K : Type u_3}
  (Q : Overfull.Multigraph V E) (a b : V) (hab : a ≠ b) (h : ℕ) (classOf : V → E → K) (C : Finset (E ⊕ Fin h))
  (hclosed :
    ∀ (X : Finset V),
      (a ∈ X) = (b ∈ X) → ∀ (v : V) (k : K), 2 * (Q.classCutOn classOf C.toLeft v k X).card ≤ (Q.cutOn C.toLeft X).card)
  (hseparating :
    ∀ (X : Finset V),
      (a ∈ X) ≠ (b ∈ X) →
        C.toRight.card ≤ (Q.cutOn C.toLeft X).card ∧
          ∀ (v : V) (k : K), (Q.classCutOn classOf C.toLeft v k X).card ≤ C.toRight.card) :
  (Q.pairAugmentation a b hab h).AdmissibleOn (Overfull.Multigraph.pairAugmentationClass h classOf) C
Overfull.Multigraph.pairAugmentation_admissibleOn_univ.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2} {K : Type u_3}
  (Q : Overfull.Multigraph V E) (a b : V) (hab : a ≠ b) (h : ℕ) [Fintype E] (classOf : V → E → K)
  (hclosed :
    ∀ (X : Finset V),
      (a ∈ X) = (b ∈ X) →
        ∀ (v : V) (k : K), 2 * (Q.classCutOn classOf Finset.univ v k X).card ≤ (Q.cutOn Finset.univ X).card)
  (hseparating :
    ∀ (X : Finset V),
      (a ∈ X) ≠ (b ∈ X) →
        h ≤ (Q.cutOn Finset.univ X).card ∧ ∀ (v : V) (k : K), (Q.classCutOn classOf Finset.univ v k X).card ≤ h) :
  (Q.pairAugmentation a b hab h).AdmissibleOn (Overfull.Multigraph.pairAugmentationClass h classOf) Finset.univ
Overfull.Multigraph.pairAugmentation_classCutOn_original_card.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2}
  {K : Type u_3} (Q : Overfull.Multigraph V E) (a b : V) (hab : a ≠ b) (h : ℕ) (classOf : V → E → K)
  (C : Finset (E ⊕ Fin h)) (v : V) (k : K) (X : Finset V) :
  ((Q.pairAugmentation a b hab h).classCutOn (Overfull.Multigraph.pairAugmentationClass h classOf) C v (Sum.inl k)
        X).card =
    (Q.classCutOn classOf C.toLeft v k X).card
Overfull.Multigraph.pairAugmentation_classCutOn_virtual_card.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2}
  {K : Type u_3} (Q : Overfull.Multigraph V E) (a b : V) (hab : a ≠ b) (h : ℕ) (classOf : V → E → K)
  (C : Finset (E ⊕ Fin h)) (v : V) (X : Finset V) :
  ((Q.pairAugmentation a b hab h).classCutOn (Overfull.Multigraph.pairAugmentationClass h classOf) C v (Sum.inr ())
        X).card =
    if (a ∈ X) ≠ (b ∈ X) ∧ (v = a ∨ v = b) then C.toRight.card else 0
Overfull.Multigraph.pairAugmentation_cutOn_card.{u_1, u_2} {V : Type u_1} {E : Type u_2} (Q : Overfull.Multigraph V E)
  (a b : V) (hab : a ≠ b) (h : ℕ) (C : Finset (E ⊕ Fin h)) (X : Finset V) :
  ((Q.pairAugmentation a b hab h).cutOn C X).card =
    (Q.cutOn C.toLeft X).card + if (a ∈ X) ≠ (b ∈ X) then C.toRight.card else 0
Overfull.Multigraph.pairAugmentation_cutOn_toLeft.{u_1, u_2} {V : Type u_1} {E : Type u_2} (Q : Overfull.Multigraph V E)
  (a b : V) (hab : a ≠ b) (h : ℕ) (C : Finset (E ⊕ Fin h)) (X : Finset V) :
  ((Q.pairAugmentation a b hab h).cutOn C X).toLeft = Q.cutOn C.toLeft X
Overfull.Multigraph.pairAugmentation_cutOn_toRight.{u_1, u_2} {V : Type u_1} {E : Type u_2}
  (Q : Overfull.Multigraph V E) (a b : V) (hab : a ≠ b) (h : ℕ) (C : Finset (E ⊕ Fin h)) (X : Finset V) :
  ((Q.pairAugmentation a b hab h).cutOn C X).toRight = if (a ∈ X) ≠ (b ∈ X) then C.toRight else ∅
Overfull.Multigraph.pairAugmentation_cutOn_univ_card.{u_1, u_2} {V : Type u_1} {E : Type u_2}
  (Q : Overfull.Multigraph V E) (a b : V) (hab : a ≠ b) (h : ℕ) [Fintype E] (X : Finset V) :
  ((Q.pairAugmentation a b hab h).cutOn Finset.univ X).card =
    (Q.cutOn Finset.univ X).card + if (a ∈ X) ≠ (b ∈ X) then h else 0
Overfull.Multigraph.pairAugmentation_degree.{u_1, u_2} {V : Type u_1} {E : Type u_2} (Q : Overfull.Multigraph V E)
  (a b : V) (hab : a ≠ b) (h : ℕ) [Fintype E] (v : V) :
  (Q.pairAugmentation a b hab h).degree v = Q.degree v + if v = a ∨ v = b then h else 0
Overfull.Multigraph.pairAugmentation_degreeOn_split.{u_1, u_2} {V : Type u_1} {E : Type u_2}
