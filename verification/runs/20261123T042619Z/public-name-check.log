  (hC : (Q.pairAugmentation a b hab h).IsCircuit C)
  (hcompatible : (Q.pairAugmentation a b hab h).Compatible (Overfull.Multigraph.pairAugmentationClass h classOf) C) :
  C.toLeft.Nonempty
