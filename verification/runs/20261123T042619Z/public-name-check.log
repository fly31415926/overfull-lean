Overfull.Multigraph.pairAugmentation_edge_inr.{u_1, u_2} {V : Type u_1} {E : Type u_2} (Q : Overfull.Multigraph V E)
  (a b : V) (hab : a ≠ b) (h : ℕ) (j : Fin h) : (Q.pairAugmentation a b hab h).edge (Sum.inr j) = s(a, b)
Overfull.Multigraph.pairAugmentation_even_degreeOn_of_parity.{u_1, u_2} {V : Type u_1} {E : Type u_2}
  (Q : Overfull.Multigraph V E) (a b : V) (hab : a ≠ b) (h : ℕ) (C : Finset (E ⊕ Fin h))
  (hparity : ∀ (v : V), Q.degreeOn C.toLeft v % 2 = if v = a ∨ v = b then C.toRight.card % 2 else 0) (v : V) :
  Even ((Q.pairAugmentation a b hab h).degreeOn C v)
Overfull.Multigraph.pairAugmentation_firstEnd_inl.{u_1, u_2} {V : Type u_1} {E : Type u_2} (Q : Overfull.Multigraph V E)
  (a b : V) (hab : a ≠ b) (h : ℕ) (e : E) : (Q.pairAugmentation a b hab h).firstEnd (Sum.inl e) = Q.firstEnd e
Overfull.Multigraph.pairAugmentation_incident_inr.{u_1, u_2} {V : Type u_1} {E : Type u_2} (Q : Overfull.Multigraph V E)
  (a b : V) (hab : a ≠ b) (h : ℕ) (j : Fin h) (v : V) :
