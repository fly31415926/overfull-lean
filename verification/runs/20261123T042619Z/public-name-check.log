      Finset.univ) :
  P.pairVirtualParts.card = h
Overfull.Multigraph.CompatibleCircuitPartition.pairVirtual_card_sum.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2}
  {K : Type u_3} {Q : Overfull.Multigraph V E} {a b : V} {hab : a ≠ b} {h : ℕ} [Fintype E] {classOf : V → E → K}
  (P :
